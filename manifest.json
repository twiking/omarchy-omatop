{
  "schemaVersion": 1,
  "id": "io.github.twiking.omatop",
  "name": "Omatop",
  "version": "1.0.0",
  "author": "Tobias Wiking",
  "license": "MIT",
  "description": "CPU and memory usage in the bar with a per-process breakdown popup, Docker container awareness, and smart process-name resolution.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Omatop",
    "description": "CPU and memory usage plus the top processes eating each, with Docker container names.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "processCount": 7,
      "refreshIntervalSec": 3,
      "showLabel": true
    },
    "schema": [
      {
        "key": "processCount",
        "type": "integer",
        "label": "Processes listed per metric",
        "min": 1,
        "max": 20,
        "step": 1,
        "defaultValue": 7
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "showLabel",
        "type": "boolean",
        "label": "Show the values next to the icons",
        "defaultValue": true
      }
    ]
  }
}
